#!/usr/bin/env bash
set -e

# AppRun script for Nuah AppImage
APPDIR="$(dirname "$(readlink -f "$0")")"

export APPDIR
export PATH="$APPDIR/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Ensure standard display variables are available
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"
if [ -z "$XDG_RUNTIME_DIR" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# Bundle library paths
ART_DIR="$APPDIR/lib/art"
ATL_BIO_DIR="$APPDIR/lib/atl-bionic"
HYBRIS_DIR="$APPDIR/lib/hybris"
ANDROID_DIR="$APPDIR/lib/android"
NATIVES_DIR="$APPDIR/share/java/art/natives"
ATL_DIR="$APPDIR/share/java/atl"

# Default high performance parameters
export NUAH_GRAPHICS_BACKEND="${NUAH_GRAPHICS_BACKEND:-vulkan}"
export NUAH_PERFORMANCE_MODE="${NUAH_PERFORMANCE_MODE:-turbo}"
export NUAH_VULKAN_PRESENT_MODE="${NUAH_VULKAN_PRESENT_MODE:-fifo}"
export NUAH_VULKAN_SUBMIT_THREAD="${NUAH_VULKAN_SUBMIT_THREAD:-1}"
export MESA_VK_ENABLE_SUBMIT_THREAD="${MESA_VK_ENABLE_SUBMIT_THREAD:-1}"
export NUAH_INPUT_COALESCE="${NUAH_INPUT_COALESCE:-1}"
export NUAH_NONBLOCK_WAYLAND_EVENTS="${NUAH_NONBLOCK_WAYLAND_EVENTS:-0}"
export NUAH_MOUSE_CAPTURE="${NUAH_MOUSE_CAPTURE:-1}"
export NUAH_FAST_RENDER="${NUAH_FAST_RENDER:-1}"
export NUAH_ASSET_BACKGROUND="${NUAH_ASSET_BACKGROUND:-1}"
export NUAH_DISABLE_RBX_TRANSPORT_DUMMY="${NUAH_DISABLE_RBX_TRANSPORT_DUMMY:-1}"
export NUAH_TASK_THREADS="${NUAH_TASK_THREADS:-4}"
export NUAH_TARGET_FPS="${NUAH_TARGET_FPS:-60}"

# ICU preload for native runner
ICU_PRELOAD=""
for icu in "$ART_DIR"/libicudata.so* "$ART_DIR"/libicuuc.so* "$ART_DIR"/libicui18n.so*; do
  if [ -r "$icu" ]; then
    ICU_PRELOAD="${ICU_PRELOAD:+$ICU_PRELOAD:}$icu"
  fi
done

PNG_JPEG_PRELOAD=""
for img_lib in "$ART_DIR"/libpng16.so.16 "$ART_DIR"/libjpeg.so.62 /usr/lib64/libpng16.so.16 /usr/lib64/libjpeg.so.62 /usr/lib/x86_64-linux-gnu/libpng16.so.16 /usr/lib/x86_64-linux-gnu/libjpeg.so.62; do
  if [ -r "$img_lib" ]; then
    PNG_JPEG_PRELOAD="${PNG_JPEG_PRELOAD:+$PNG_JPEG_PRELOAD:}$img_lib"
  fi
done

# Configure Nuah native environment
export NUAH_ART_LIBRARY_DIR="$ART_DIR"
export NUAH_ATL_ANDROID16_HOME="$APPDIR/share/java/art"
export NUAH_ATL_HOME="$ATL_DIR"
export NUAH_ATL_NATIVE_DIR="$ATL_DIR"
export NUAH_ATL_LIBRARY_DIR="$ATL_BIO_DIR"
export NUAH_HYBRIS_LIBRARY="$HYBRIS_DIR/libhybris-common.so"
export HYBRIS_LINKER_DIR="$HYBRIS_DIR/libhybris/linker"
export LD_LIBRARY_PATH="$ART_DIR:$NATIVES_DIR:$HYBRIS_DIR:$ATL_BIO_DIR:$ANDROID_DIR:${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_PRELOAD="${PNG_JPEG_PRELOAD:+$PNG_JPEG_PRELOAD:}${ICU_PRELOAD:+$ICU_PRELOAD:}$ART_DIR/libandroidfw.so:${LD_PRELOAD:+:$LD_PRELOAD}"

if [ "$#" -eq 0 ]; then
  exec "$APPDIR/bin/nuah" --help
elif [ "$1" = "native-run" ] || [ "$1" = "config" ] || [ "$1" = "atl-run" ] || [ "$1" = "sober-cache-status" ] || [ "$1" = "adopt-sober-cache" ]; then
  exec "$APPDIR/bin/nuah" "$@"
else
  exec "$APPDIR/bin/nuah" native-run "$@"
fi
