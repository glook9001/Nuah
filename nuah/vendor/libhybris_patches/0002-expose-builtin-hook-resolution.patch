+/*
+ * Let a context-specific callback delegate to libhybris before adding its
+ * narrow platform providers.  The TLS guard avoids recursively invoking the
+ * callback while preserving the existing public callback ABI.
+ */
+void *hybris_get_builtin_hook(const char *symbol, const char *requester)
+{
+    void *result;
+    skip_hook_callback++;
+    result = __hybris_get_hooked_symbol(symbol, requester);
+    skip_hook_callback--;
+    return result;
+}
