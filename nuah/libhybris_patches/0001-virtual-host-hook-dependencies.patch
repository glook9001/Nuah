diff --git a/hybris/common/q/dlfcn.cpp b/hybris/common/q/dlfcn.cpp
--- a/hybris/common/q/dlfcn.cpp
+++ b/hybris/common/q/dlfcn.cpp
@@ -359,6 +359,23 @@ soinfo* get_libdl_info(const char* linker_path, const soinfo& linker_si) {
   return __libdl_info;
 }
 
+soinfo* get_host_hook_dependency(android_namespace_t* ns, const char* name) {
+  if (strcmp(name, "libc.so") != 0 &&
+      strcmp(name, "libdl.so") != 0 &&
+      strcmp(name, "libm.so") != 0) {
+    return nullptr;
+  }
+
+  // This record represents a dependency whose relocations use host hooks.
+  soinfo* si = new soinfo(ns, name, nullptr, 0, RTLD_NOW);
+  si->set_soname(name);
+  si->set_linked();
+  si->set_nodelete();
+  si->generate_handle();
+  ns->add_soinfo(si);
+  return si;
+}
+
 // hybris compat
